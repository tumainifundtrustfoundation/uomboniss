rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Valid alphanumeric ID with bounds
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Helper: User is signed in via Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper: Fetch current user document safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if account has been verified and approved by school administration
    function isApproved() {
      return isAuthenticated() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().status == 'approved'
        )
      );
    }

    // Helper: Check user role
    function hasRole(roleName) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == roleName;
    }

    function isAdmin() {
      return (isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'lupanulla.co.tz@gmail.com' ||
          request.auth.token.email == 'tumainifundtrustfoundation@gmail.com' ||
          request.auth.token.email == 'adolphmassawe@gmail.com' ||
          request.auth.token.email == 'uombiniss.sc.tz@gmail.com' ||
          request.auth.token.email == 'uomboniss.sc.tz@gmail.com' ||
          request.auth.token.email == 'yohanabahati665@gmail.com' ||
          request.auth.token.email == 'headmaster@uombonisecondary.ac.tz' ||
          request.auth.token.email.matches('.*admin.*@uomboni.*')
        ))
      )) || (hasRole('admin') && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().status == 'approved');
    }

    function isAcademicMaster() {
      return isAdmin() || (hasRole('academic_master') && isApproved()) || (
        isAuthenticated() && request.auth.token.email != null && (
          request.auth.token.email == 'yohana.bahati@uombonisec.ac.tz' ||
          request.auth.token.email == 'adela.manyanga@uombonisec.ac.tz' ||
          request.auth.token.email == 'yohanabahati665@gmail.com' ||
          request.auth.token.email.matches('.*academic.*@uomboni.*')
        )
      );
    }

    function isBursar() {
      return isAdmin() || (hasRole('bursar') && isApproved()) || (
        isAuthenticated() && request.auth.token.email != null && (
          request.auth.token.email == 'sigminja@gmail.com' ||
          request.auth.token.email.matches('.*bursar.*@uomboni.*')
        )
      );
    }

    function isTeacher() {
      return isAdmin() || isAcademicMaster() || (hasRole('teacher') && isApproved()) || (
        isAuthenticated() && request.auth.token.email != null && 
        request.auth.token.email.matches('.*(teacher|walimu|academic).*@uomboni.*')
      );
    }

    function isStaff() {
      return isAdmin() || isTeacher() || isBursar() || (hasRole('staff') && isApproved());
    }

    // ====================================================
    // SYSTEM & HEALTH CONNECTION CHECKS
    // ====================================================
    match /test/{testDocId} {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /system/{systemDocId} {
      allow get: if true;
      allow write: if isAdmin();
    }

    // ====================================================
    // USERS COLLECTION (users/{userId})
    // Enforces UID matching, zero self-privilege escalation,
    // mandatory pending status on new self-registration,
    // and immutable role/status/subjects for non-admins.
    // ====================================================
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isAcademicMaster());
      allow list: if isAdmin();
      
      // On create:
      // Admins can create approved accounts.
      // Normal self-registering users:
      // - Must set uid matching auth.uid
      // - Must have status == 'pending'
      // - CANNOT assign themselves 'admin', 'academic_master', 'teacher', or 'bursar'
      // - CANNOT assign themselves departments or subjects
      allow create: if isAuthenticated() && 
        isValidId(userId) && 
        request.resource.data.uid == userId &&
        (request.auth.uid == userId || isAdmin()) &&
        (
          isAdmin() ||
          (
            request.resource.data.status == 'pending' &&
            !(request.resource.data.role in ['admin', 'academic_master', 'teacher', 'bursar'])
          )
        );

      // On update:
      // Admins can update any user field.
      // Normal users can ONLY update their personal non-RBAC fields.
      // Normal users CANNOT change role, status, assignedDepartments, or assignedSubjects.
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (
          request.auth.uid == userId && 
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          (!('assignedDepartments' in resource.data) || request.resource.data.assignedDepartments == resource.data.assignedDepartments) &&
          (!('assignedSubjects' in resource.data) || request.resource.data.assignedSubjects == resource.data.assignedSubjects)
        )
      );

      allow delete: if isAdmin();
    }

    // ====================================================
    // STUDENTS COLLECTION (Personal Data Protection)
    // Only authenticated and approved staff/students/parents can view biodata
    // Only Admin & Academic Master can modify
    // ====================================================
    match /students/{studentDocId} {
      allow get, list: if isAuthenticated() && (
        isAdmin() || 
        isAcademicMaster() || 
        isTeacher() || 
        (hasRole('parent') && isApproved()) ||
        (hasRole('student') && isApproved())
      );
      allow create, update, delete: if isValidId(studentDocId) && (isAdmin() || isAcademicMaster());
    }

    // ====================================================
    // PARENTS COLLECTION
    // ====================================================
    match /parents/{parentDocId} {
      allow get: if isAuthenticated() && (request.auth.uid == parentDocId || isStaff());
      allow list: if isStaff();
      allow create, update: if isValidId(parentDocId) && (request.auth.uid == parentDocId || isStaff());
      allow delete: if isAdmin();
    }

    // ====================================================
    // TEACHERS COLLECTION
    // Public directory of teachers; only admin can create/modify
    // ====================================================
    match /teachers/{teacherDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(teacherDocId) && isAdmin();
    }

    // ====================================================
    // STAFF COLLECTION
    // ====================================================
    match /staff/{staffDocId} {
      allow get, list: if isAuthenticated() && isApproved();
      allow create, update, delete: if isValidId(staffDocId) && isAdmin();
    }

    // ====================================================
    // CLASSES & SUBJECTS COLLECTIONS
    // ====================================================
    match /classes/{classDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(classDocId) && (isAdmin() || isAcademicMaster());
    }

    match /subjects/{subjectDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(subjectDocId) && (isAdmin() || isAcademicMaster());
    }

    // ====================================================
    // EXAMINATIONS & SITTINGS
    // ====================================================
    match /exams/{examDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(examDocId) && (isAdmin() || isAcademicMaster());
    }

    // ====================================================
    // ACADEMIC RESULTS
    // Published results can be read by public/students.
    // Unpublished/draft marks are strictly restricted to staff.
    // Only Admin & Academic Master can record or publish official results.
    // ====================================================
    match /results/{resultDocId} {
      allow get, list: if (resource.data.status == 'published') || isAdmin() || isAcademicMaster() || (isTeacher() && isApproved());
      allow create, update, delete: if isValidId(resultDocId) && (isAdmin() || isAcademicMaster());
    }

    // Certified published examination results
    match /published_results/{publishedDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(publishedDocId) && (isAdmin() || isAcademicMaster());
    }

    // Pending teacher submissions awaiting Academic Master certification
    // Only approved teachers can submit marks for their assigned subjects; they cannot self-approve
    match /pendingResults/{pendingDocId} {
      allow get, list: if isAdmin() || isAcademicMaster() || (isTeacher() && isApproved());
      allow create: if isValidId(pendingDocId) && isTeacher() && isApproved() && 
        (request.resource.data.status in ['draft', 'pending']) && 
        (request.resource.data.status != 'approved');
      allow update: if isValidId(pendingDocId) && (
        isAdmin() ||
        isAcademicMaster() ||
        (
          isTeacher() && isApproved() &&
          resource.data.status in ['draft', 'returned'] &&
          request.resource.data.status in ['draft', 'pending'] &&
          request.resource.data.status != 'approved'
        )
      );
      allow delete: if isValidId(pendingDocId) && (
        isAdmin() ||
        (isTeacher() && isApproved() && resource.data.status == 'draft')
      );
    }

    match /subjectSubmissions/{subDocId} {
      allow get, list: if isAdmin() || isAcademicMaster() || (isTeacher() && isApproved());
      allow create: if isValidId(subDocId) && isTeacher() && isApproved() && 
        (request.resource.data.status in ['draft', 'pending']) && 
        (request.resource.data.status != 'approved');
      allow update: if isValidId(subDocId) && (
        isAdmin() ||
        isAcademicMaster() ||
        (
          isTeacher() && isApproved() &&
          resource.data.status in ['draft', 'returned'] &&
          request.resource.data.status in ['draft', 'pending'] &&
          request.resource.data.status != 'approved'
        )
      );
      allow delete: if isValidId(subDocId) && (
        isAdmin() ||
        (isTeacher() && isApproved() && resource.data.status == 'draft')
      );
    }

    // Legacy or alternate path compatibility
    match /academicResults/{resultDocId} {
      allow get, list: if true;
      allow create, update: if isValidId(resultDocId) && (isAdmin() || isAcademicMaster() || isTeacher());
      allow delete: if isValidId(resultDocId) && isAdmin();
    }

    // ====================================================
    // ATTENDANCE & ASSIGNMENTS
    // ====================================================
    match /attendance/{attendanceDocId} {
      allow get, list: if isAuthenticated();
      allow create, update, delete: if isValidId(attendanceDocId) && isTeacher();
    }

    match /assignments/{assignmentDocId} {
      allow get, list: if isAuthenticated();
      allow create, update, delete: if isValidId(assignmentDocId) && isTeacher();
    }

    // ====================================================
    // ANNOUNCEMENTS
    // Read: all users; Write: teachers and admins
    // ====================================================
    match /announcements/{announcementDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(announcementDocId) && isTeacher();
    }

    // ====================================================
    // ACADEMIC DIRECTIVES & MARK ENTRY WINDOWS
    // Read: all teachers & public; Write: Academic Master & staff
    // ====================================================
    match /academicDirectives/{directiveDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(directiveDocId) && (isAcademicMaster() || isAdmin() || isStaff());
    }

    // ====================================================
    // EXAM TYPES (Aina za Mitihani)
    // Read: all teachers & public; Write: Academic Master & Admin
    // ====================================================
    match /examTypes/{examTypeDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(examTypeDocId) && (isAcademicMaster() || isAdmin() || isStaff());
    }

    // ====================================================
    // SETTINGS (School Profile, Contacts, Registration)
    // Read: all; Write: admin
    // ====================================================
    match /settings/{settingDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingDocId) && isAdmin();
    }

    // ====================================================
    // NOTIFICATIONS
    // Users can read their own notifications or broadcasts
    // ====================================================
    match /notifications/{notificationDocId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.userId == 'all' || 
        isAdmin()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Fee payments (Restricted to school Bursar, Administration, and Staff - NO PUBLIC LEAKS)
    match /feePayments/{paymentDocId} {
      allow get, list: if isStaff() || isBursar() || isAdmin();
      allow create, update, delete: if isValidId(paymentDocId) && (isAdmin() || isBursar());
    }

    // ====================================================
    // IMMUTABLE AUDIT LOGS (Append-Only Trail)
    // Read: Admin & Academic Master
    // Create: Validated logging for security & exam actions (payload size bounded)
    // Update/Delete: STRICTLY FORBIDDEN
    // ====================================================
    match /auditLogs/{logId} {
      allow get, list: if isAdmin() || isAcademicMaster();
      allow create: if isValidId(logId) && 
        request.resource.data.size() <= 25 &&
        (request.resource.data.keys().hasAll(['action', 'timestamp']) || isAuthenticated());
      allow update, delete: if false;
    }

    // ====================================================
    // BACKUPS & DISASTER RECOVERY SNAPSHOTS
    // Read/Create/Delete: Admin & Academic Master only
    // Update: STRICTLY FORBIDDEN (Immutable snapshots)
    // ====================================================
    match /backups/{backupId} {
      allow get, list, create, delete: if isValidId(backupId) && (isAdmin() || isAcademicMaster());
      allow update: if false;
    }

    // ====================================================
    // VIDEOS & MULTIMEDIA
    // Read: all; Write: admin & staff only
    // ====================================================
    match /school_videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(videoId) && (isAdmin() || isStaff());
    }

    // ====================================================
    // ADMISSION APPLICATIONS
    // Public can submit application (payload size bounded); only staff can view & process
    // ====================================================
    match /applications/{appId} {
      allow create: if isValidId(appId) && request.resource.data.size() <= 30;
      allow get, list, update, delete: if isValidId(appId) && (isAdmin() || isStaff());
    }

    // ====================================================
    // CENTRALIZED SCHOOL DATA (Cloud Firestore Persistence)
    // Synchronizes school results, calendar, news, and teachers across all devices & deployments
    // ====================================================
    match /school_data/{dataDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(dataDocId) && (isAdmin() || isStaff());
    }

    // ====================================================
    // SCHOOL DOCUMENTS (Google Drive & PDF Files)
    // Read: all; Write: admin & staff
    // ====================================================
    match /school_documents/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(docId) && (isAdmin() || isStaff());
    }
  }
}

